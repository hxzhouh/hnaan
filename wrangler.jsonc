{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hnaan-website",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "hnaan-content", "database_id": "56da3495-984d-461c-a314-0b8a750609fb", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "hnaan-media"}],
  "vars": {"SITE_URL": "http://localhost:8787"},
  "observability": {"enabled": true}
}
