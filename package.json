{
  "name": "hnaan-portable-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "import": "python3 scripts/import.py && node scripts/compile-templates.mjs",
    "dev": "wrangler dev --port 8787",
    "check": "tsc --noEmit",
    "build": "node scripts/prepare-assets.mjs && wrangler deploy --dry-run --outdir dist --assets dist/assets",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/verify-deployment.mjs && node scripts/prepare-assets.mjs --external-media && wrangler deploy --assets dist/assets",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:node": "tsx src/node.ts",
    "build:node": "esbuild src/node.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-node/server.mjs",
    "start:node": "node dist-node/server.mjs",
    "db:mysql": "node scripts/migrate-mysql.mjs",
    "db:seed:local": "wrangler d1 execute DB --local --file seeds/original-d1.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file seeds/original-d1.sql",
    "db:seed:mysql": "node scripts/seed-mysql.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "mysql2": "^3.24.6",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/sanitize-html": "latest",
    "esbuild": "^0.28.2",
    "php-parser": "latest",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "tsx": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=22.23.5 <23 || >=24"
  }
}
