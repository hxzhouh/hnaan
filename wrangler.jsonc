{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hnaan-website",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hnaan-content",
      "database_id": "096a71c4-910a-4578-94f1-714ff0193765",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "hnaan-media"
    }
  ],
  "vars": {
    "SITE_URL": "https://hnaan.cn"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "hnaan.cn",
      "custom_domain": true
    },
    {
      "pattern": "www.hnaan.cn",
      "custom_domain": true
    }
  ]
}
